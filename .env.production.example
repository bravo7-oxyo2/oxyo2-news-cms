# This is POSIX-shell compatible because deploy-rsync.sh loads it with `source`.
# Copy it to .env.production on the server, replace every REPLACE_ME value, and
# keep the real file out of Git.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

DATABASE_URL="postgresql://cms:REPLACE_ME@127.0.0.1:5432/cms"
SESSION_SECRET="REPLACE_ME_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_ME_WITH_A_STRONG_INITIAL_PASSWORD"

PUBLIC_BASE_URL="https://news.example.com"
ADMIN_ORIGIN="https://admin.example.com"
UPLOAD_DIR="/home/ubuntu/apps/cms/shared/uploads"
MAX_UPLOAD_BYTES=524288000

# Leave SMTP_HOST blank only when password-reset email is intentionally disabled.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CMS <no-reply@example.com>"

# Production text rewrites use DeepSeek's OpenAI-compatible chat API. Local
# development uses Ollama instead; do not add production keys to this template.
DEEPSEEK_API_KEY="REPLACE_ME"
DEEPSEEK_API_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Optional stock-image providers. The bot tries Pexels, then Pixabay, then Unsplash.
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
UNSPLASH_ACCESS_KEY=""
# Backend scheduler and dedicated PM2 worker poll interval; this is not the
# user-configured news-bot run interval.
NEWS_BOT_POLL_INTERVAL_SECONDS=60

# Google Search Console (admin-only, read-only OAuth). Keep the encrypted token
# file outside Git. The redirect URI defaults to ADMIN_ORIGIN plus the callback
# path when left blank.
GSC_OAUTH_CLIENT_ID="REPLACE_ME"
GSC_OAUTH_CLIENT_SECRET="REPLACE_ME"
GSC_TOKEN_ENCRYPTION_KEY="REPLACE_ME_WITH_A_UNIQUE_HIGH_ENTROPY_SECRET"
GSC_TOKEN_STORE_PATH="/home/ubuntu/apps/cms/shared/gsc-connection.enc"
GSC_OAUTH_REDIRECT_URI=""
# Dedicated bearer token for server-to-server GSC automation exports. Leave
# blank until you generate a unique value; never reuse an OAuth/client secret.
GSC_AUTOMATION_EXPORT_TOKEN=""
