NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://cms:change-me@127.0.0.1:5432/cms
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
PUBLIC_BASE_URL=http://localhost:5174
ADMIN_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=524288000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CMS <no-reply@example.com>"
# Used only when NODE_ENV=production. Local development uses Ollama below.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
NEWS_BOT_POLL_INTERVAL_SECONDS=60
NEWS_BOT_TIMEZONE=Asia/Kuala_Lumpur
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:latest
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Google Search Console (admin-only, read-only OAuth). Keep the token file outside Git.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_TOKEN_ENCRYPTION_KEY=replace-with-a-unique-high-entropy-secret
GSC_TOKEN_STORE_PATH=/home/ubuntu/apps/cms/shared/gsc-connection.enc
# Defaults to $ADMIN_ORIGIN/api/admin/search-console/oauth/callback when blank.
GSC_OAUTH_REDIRECT_URI=
# Development-only bearer token for the Codex scheduled automation export endpoint.
# Generate a unique value of at least 32 characters. Never commit or expose it.
GSC_AUTOMATION_EXPORT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_TOKEN_ENCRYPTION_KEY=
GSC_TOKEN_STORE_PATH="/home/ubuntu/apps/cms/shared/gsc-connection.enc"
GSC_OAUTH_REDIRECT_URI="https://admin.thepaperleaf.com/api/admin/search-console/oauth/callback"

