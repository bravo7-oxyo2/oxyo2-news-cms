generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum ContentType {
  POST
  PAGE
}
enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}
enum ResetTokenStatus {
  ACTIVE
  USED
}
enum NewsBotRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}
enum NewsBotTrigger {
  SCHEDULED
  MANUAL
}
enum NewsBotItemStatus {
  PENDING
  CREATED
  SKIPPED
  FAILED
}
enum NewsBotLogLevel {
  INFO
  WARN
  ERROR
}
enum ContentLanguage {
  ZH_CN
  EN
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String @default("Administrator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resetTokens PasswordResetToken[]
}

model Content {
  id String @id @default(cuid())
  type ContentType
  status ContentStatus @default(DRAFT)
  title String
  slug String
  excerpt String @default("")
  category String @default("General")
  authorName String @default("Editorial Desk")
  sourceLabel String?
  sourceUrl String?
  sourceCountryCode String @default("MY") @db.Char(2)
  isFeatured Boolean @default(false)
  categoryId String?
  categoryRef Category? @relation("ContentCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  markdown String @default("") @db.Text
  html String @default("") @db.Text
  wordCount Int @default(0)
  coverMediaId String?
  coverMedia Media? @relation("CoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  newsBotItem NewsBotItem?
  translations ContentTranslation[]
  visualNeedsReview Boolean @default(false)
  tags String[] @default([])
  seoTitle String?
  seoDescription String?
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([type, slug])
  @@index([type, status, publishedAt])
  @@index([type, category, status, publishedAt])
  @@index([type, categoryId, status, publishedAt])
  @@index([type, isFeatured, status, publishedAt])
  @@index([type, sourceCountryCode, status, publishedAt])
  @@index([updatedAt])
}

model ContentTranslation {
  id String @id @default(cuid())
  contentId String
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  language ContentLanguage
  title String
  excerpt String @default("")
  markdown String @default("") @db.Text
  html String @default("") @db.Text
  wordCount Int @default(0)
  seoTitle String?
  seoDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([contentId, language])
  @@index([language])
}

model NewsBotSettings {
  id String @id @default("default")
  enabled Boolean @default(false)
  intervalMinutes Int @default(120)
  articleLimit Int?
  workingStartHour Int @default(8)
  workingEndHour Int @default(0)
  lastRunAt DateTime?
  lastScheduledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsBotSource {
  id String @id @default(cuid())
  name String @unique
  feedUrl String
  sourceLabel String
  category String @default("General")
  categoryId String?
  countryCode String @default("MY") @db.Char(2)
  credentialEnvKey String?
  allowsSourceImageReference Boolean @default(false)
  sourceImagePermissionUrl String?
  isEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items NewsBotItem[]
  logs NewsBotLog[]
  @@index([isEnabled])
  @@index([countryCode, isEnabled])
}

/// Country settings are sparse: countries without a row use the safe defaults
/// (enabled for retrieval and reader listings). This keeps the ISO directory
/// admin-managed without pre-seeding hundreds of mutable records.
model NewsBotCountry {
  code String @id @db.Char(2)
  retrievalEnabled Boolean @default(false)
  displayEnabled Boolean @default(false)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([retrievalEnabled])
  @@index([displayEnabled])
  @@index([isDefault])
}

model NewsBotRun {
  id String @id @default(cuid())
  trigger NewsBotTrigger
  status NewsBotRunStatus @default(QUEUED)
  sourceCount Int @default(0)
  processedCount Int @default(0)
  createdCount Int @default(0)
  skippedCount Int @default(0)
  failedCount Int @default(0)
  error String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  items NewsBotItem[]
  logs NewsBotLog[]
  @@index([status, createdAt])
}

model NewsBotItem {
  id String @id @default(cuid())
  sourceUrl String @unique
  sourceFingerprint String? @unique
  sourceTitle String
  sourceExcerpt String? @db.Text
  sourcePublishedAt DateTime?
  sourceImageUrl String?
  status NewsBotItemStatus @default(PENDING)
  error String?
  retryCount Int @default(0)
  lastFailureAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sourceId String
  source NewsBotSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runId String?
  run NewsBotRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  contentId String? @unique
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  logs NewsBotLog[]
  @@index([sourceId, status])
}

model NewsBotLog {
  id String @id @default(cuid())
  level NewsBotLogLevel @default(INFO)
  stage String
  message String @db.Text
  context Json?
  createdAt DateTime @default(now())
  runId String
  run NewsBotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId String?
  source NewsBotSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  itemId String?
  item NewsBotItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  @@index([runId, createdAt])
  @@index([itemId, createdAt])
}

model Category {
  id String @id @default(cuid())
  name String @unique
  nameZh String @default("")
  slug String @unique
  description String @default("")
  descriptionZh String @default("")
  color String @default("#2521E1")
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents Content[] @relation("ContentCategory")
  @@index([isActive, sortOrder])
}

model Media {
  id String @id @default(cuid())
  filename String
  originalName String
  path String @unique
  url String
  mimeType String
  extension String
  size BigInt
  checksum String
  width Int?
  height Int?
  duration Float?
  altText String @default("")
  caption String @default("")
  provider String?
  providerAssetId String?
  attributionName String?
  attributionUrl String?
  license String?
  visualOrigin String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  covers Content[] @relation("CoverMedia")
  @@index([createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  tokenHash String @unique
  status ResetTokenStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}
